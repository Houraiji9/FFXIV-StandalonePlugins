<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsDalamudPlugin>true</IsDalamudPlugin>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RetainerWorkshop</AssemblyName>
    <Version>0.1.7.0</Version>
    <AssemblyVersion>0.1.7.0</AssemblyVersion>
    <FileVersion>0.1.7.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Update="RetainerWorkshop.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Compile the already verified engines into this independent assembly. No dependency on old plugin DLLs. -->
    <Compile Include="../RetainerCraftBridge/Contracts.cs" Link="Engines/Contracts.cs" />
    <Compile Include="../RetainerCraftBridge/CraftContracts.cs" Link="Engines/CraftContracts.cs" />
    <Compile Include="../RetainerCraftBridge/CraftNativeService.cs" Link="Engines/CraftNativeService.cs" />
    <Compile Include="../RetainerCraftBridge/CraftRules.cs" Link="Engines/CraftRules.cs" />
    <Compile Include="../RetainerCraftBridge/MaterialRestockService.cs" Link="Engines/MaterialRestockService.cs" />
    <Compile Include="../RetainerCraftBridge/MaterialRules.cs" Link="Engines/MaterialRules.cs" />
    <Compile Include="../RetainerVendorSweep/VendorDomain.cs" Link="Engines/VendorDomain.cs" />
    <Compile Include="../RetainerVendorSweep/VendorNativeRules.cs" Link="Engines/VendorNativeRules.cs" />
    <Compile Include="../RetainerVendorSweep/VendorNativeCompatibility.cs" Link="Engines/VendorNativeCompatibility.cs" />
    <Compile Include="../RetainerVendorSweep/NativeSaleService.cs" Link="Engines/NativeSaleService.cs" />
    <Compile Include="../RetainerVendorSweep/SweepMachine.cs" Link="Engines/SweepMachine.cs" />
    <Compile Include="../RetainerVendorSweep/OwnedUiSuppression.cs" Link="Engines/OwnedUiSuppression.cs" />
  </ItemGroup>
</Project>
